# DreamOpenWRT — OpenWrt x86/64 固件配置
#
# 这是 .config 的唯一来源。构建脚本会把它拷进源码树、跑一次 make defconfig，
# 然后逐项校验：必需项（REQUIRED_SYMBOLS）缺一个就直接失败，其余被丢弃的会列出来。
# 所以这里写错包名不会「静默少功能」，能在构建日志里看到。
#
# 新增/删除软件包只改这个文件，不要改脚本。

###############################################################################
# 目标平台与镜像
###############################################################################

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 额外产出 rootfs.tar.gz，容器 / LXC / WSL 场景直接可用，几乎不增加编译时间
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_GRUB_IMAGES=y
CONFIG_EFI_IMAGES=y
# 分区大小必须固定：改这个值会让已有机器无法原地 sysupgrade 保留数据
CONFIG_TARGET_ROOTFS_PARTSIZE=4096

###############################################################################
# 编译加速
###############################################################################

# ccache 的开关 CONFIG_CCACHE 挂在 menuconfig DEVEL 下面：
# config/Config-devel.in 里写的是 `bool "Use ccache" if DEVEL`，
# 不开 DEVEL 的话 defconfig 会直接把它丢掉，ccache 就不生效了。
# DEVEL 本身只是把开发者选项暴露出来，其余子项的默认值都是关闭的。
CONFIG_DEVEL=y
CONFIG_CCACHE=y

###############################################################################
# 软件包管理器（25.12 用 apk）
###############################################################################

CONFIG_USE_APK=y
CONFIG_PACKAGE_apk=y

###############################################################################
# LuCI 基础
###############################################################################

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-rpc=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-fs=y

CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# 官方默认的 uhttpd + HTTPS：luci-ssl 会带 libustream-mbedtls 和 px5g-mbedtls，
# uhttpd 启动时用 px5g 自动生成自签证书，80 和 443 同时监听（官方默认配置就是这样）
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-argon=y

###############################################################################
# LuCI 管理页面
###############################################################################

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-hd-idle=y

###############################################################################
# 第三方插件
###############################################################################

CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-advancedplus=y
CONFIG_PACKAGE_luci-app-syscontrol=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-mosdns=y
# 按局域网设备统计流量，旁路由看谁在占带宽
CONFIG_PACKAGE_luci-app-nlbwmon=y

###############################################################################
# DNS
###############################################################################

# 只用经典 LuCI 界面，AdGuardHome 的二进制由 build-openwrt.sh 在构建时
# 直接嵌入官方 release（见 embed_adguardhome），所以固件自带二进制、离线可用。
# 不用 packages feed 里那个 adguardhome 包：它要从 Go 源码编译、先拉 golang 工具链，
# 2 核上单这一项就要 20~40 分钟。
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

###############################################################################
# 网络 / 协议
###############################################################################

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ds-lite=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_miniupnpd=y

###############################################################################
# firewall4 + nftables（OpenClash 需要 tproxy / socket 模块）
###############################################################################

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

###############################################################################
# 存储 / 文件系统
###############################################################################

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_wipefs=y
CONFIG_PACKAGE_blockdev=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_blkid=y

###############################################################################
# 有线网卡驱动
# 纯 Hyper-V 场景只需要内置的 hv_netvsc，下面这批是给裸机迁移留的余量。
# 只在虚拟机里跑的话可以整段删掉，能省几分钟编译时间和十几 MB 体积。
###############################################################################

CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-atlantic=y

###############################################################################
# 常用工具
###############################################################################

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_lm-sensors-detect=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

###############################################################################
# 中文语言包
###############################################################################

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_luci-i18n-advancedplus-zh-cn=y
CONFIG_PACKAGE_luci-i18n-syscontrol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

CONFIG_LUCI_LANG_zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y
