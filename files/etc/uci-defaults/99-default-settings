#!/bin/sh
#
# 首次启动时执行一次，执行完 OpenWrt 会自动把它从 /etc/uci-defaults 移除。
# 所以 sysupgrade 保留配置升级后它不会再跑，不会覆盖你后来改过的设置。
#
# 要改默认值就改这个文件；改完重新构建即可，下次全新刷机生效。

# ---- root 密码 ----
# openssl-util 已包含在固件里；拿不到就保持空密码，宁可报出来也别悄悄写个坏 hash
if command -v openssl >/dev/null 2>&1; then
	PASSWD="$(openssl passwd -1 'root')"
	if [ -n "$PASSWD" ]; then
		sed -i "s#^root::#root:${PASSWD}:#" /etc/shadow
	fi
fi

# ---- 系统基本项 ----
uci -q set system.@system[0].hostname='OpenWrt'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q commit system

# ---- LuCI ----
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q set luci.main.lang='zh-cn'
uci -q set luci.main.lang_auto='0'
uci -q commit luci

# ---- Web 服务：保持官方默认 ----
# 官方 25.12 的 /etc/config/uhttpd 默认就监听 80 和 443，证书由 uhttpd 启动时
# 调 px5g 自动生成（luci-ssl 会带 px5g-mbedtls）。这里不再删 443、也不强制只留 80，
# 只把 HTTP 自动跳转打开，避免明文访问后台。
if [ -f /etc/config/uhttpd ]; then
	uci -q set uhttpd.main.redirect_https='1'
	uci -q commit uhttpd
fi

# ---- 让 LuCI「防火墙 → 自定义规则」页面真正生效 ----
# fw4 只执行 /etc/config/firewall 里 config include 声明的脚本，而默认配置里
# 一条 include 都没有，所以那个页面写进 /etc/firewall.user 的规则永远不会被执行。
# 这里补一条 script 类型的 include；文件本身随固件提供（缺了会让每次启动都报 include 失败）。
if ! uci -q get 'firewall.@include[0]' >/dev/null 2>&1; then
	uci add firewall include >/dev/null
	uci set 'firewall.@include[-1].path=/etc/firewall.user'
	uci set 'firewall.@include[-1].type=script'
	uci set 'firewall.@include[-1].enabled=1'
	uci commit firewall
fi

# ---- 清掉三方 feed 的软件源 ----
# 这些包已经编进固件，但上游没有对应的 apk 仓库。留着会让 apk update 一直 404。
if [ -f /etc/apk/repositories.d/distfeeds.list ]; then
	sed -i \
		-e '/\/openclash\/packages\.adb$/d' \
		-e '/\/dockerman\/packages\.adb$/d' \
		-e '/\/diskman\/packages\.adb$/d' \
		-e '/\/advancedplus\/packages\.adb$/d' \
		-e '/\/syscontrol\/packages\.adb$/d' \
		-e '/\/mosdns\/packages\.adb$/d' \
		/etc/apk/repositories.d/distfeeds.list
fi

rm -rf /tmp/luci-*

for svc in uhttpd AdGuardHome adguardhome mosdns; do
	[ -x "/etc/init.d/$svc" ] && /etc/init.d/$svc enable >/dev/null 2>&1
done

exit 0
